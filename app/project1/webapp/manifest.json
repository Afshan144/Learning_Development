{
  "_version": "1.76.0",
  "sap.app": {
    "id": "learningdev.project1",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.19.3",
      "toolsId": "3e5e6cec-3897-4c2c-bc52-ebb396cb45af"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/master/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      },
       "TransactionService": {
        "uri": "/odata/v4/transaction/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "incidents-display": {
          "semanticObject": "incidents",
          "action": "display",
          "title": "{{incidents-display.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.142.0",
      "libs": {
        "sap.m": {},
        "sap.ui.comp": {},
        "sap.ui.layout": {},
       	"sap.f": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "learningdev.project1.i18n.i18n",
          "defaultBindingMode": "TwoWay"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "txnModel": {
        "dataSource": "TransactionService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "learningdev.project1.view",
        "async": true,
        "viewPath": "learningdev.project1.view"
      },
      "routes": [
        {
          "name": "RouteView1",
          "pattern": ":?query:",
          "target": [
            "TargetView1"
          ]
        },
         {
          "name": "SaleOrderCreate",
          "pattern": "SaleOrderCreate:",
          "target": [
            "TargetSaleOrderCreate"
          ]
        },
        {
          "name": "CustomerMasterCreate",
          "pattern": "CustomerMasterCreate:",
          "target": [
            "TargetCustomerMasterCreate"
          ]
        },
        {
          "name": "ProductCreate",
          "pattern": "ProductCreate:",
          "target": [
            "TargetProductCreate"
          ]
        },
         {
          "name": "EmployeeGridList",
          "pattern": "EmployeeGridList:",
          "target": [
            "TargetEmployeeGridList"
          ]
        }
      ],
      "targets": {
        "TargetView1": {
          "id": "View1",
          "name": "View1"
        },
         "TargetCustomerMasterCreate": {
          "id": "CustomerMasterCreate",
          "name": "CustomerMasterCreate"
        },
         "TargetSaleOrderCreate": {
          "id": "SaleOrderCreate",
          "name": "SaleOrderCreate"
        },
         "TargetProductCreate": {
          "id": "ProductCreate",
          "name": "ProductCreate"
        },
        "TargetEmployeeGridList": {
          "id": "EmployeeGridList",
          "name": "EmployeeGridList"
        }
      }
    },
    "rootView": {
      "viewName": "learningdev.project1.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}