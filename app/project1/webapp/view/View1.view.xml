<mvc:View
    controllerName="learningdev.project1.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <Page title="Masters Screen">
        <content>
            <GenericTile
                class="sapUiTinyMarginBegin sapUiTinyMarginTop tileLayout"
                header="Customer Master"
                subheader="List/Save/Update"
                press="OnPressCustomer"
            />
            <GenericTile
                class="sapUiTinyMarginBegin sapUiTinyMarginTop tileLayout"
                header="Product"
                subheader="List/Save/Update"
                press="OnPressProduct"
            />
            <GenericTile
                class="sapUiTinyMarginBegin sapUiTinyMarginTop tileLayout"
                header="Sales Order"
                subheader="List/Save/Update"
                press="OnPressSalesOrder"
            />
        </content>
    </Page>
</mvc:View>
